# IDE and editor settings
^\.claude$
^\.cursor$
^\.vscode$
^.*\.Rproj$
^\.Rproj\.user$

# Git and GitHub
^\.git$
^\.gitignore$
^\.github$

# License (GPL-3 text shipped for GitHub display; CRAN already has it)
^LICENSE\.md$

# Development files
^dev$
^dev/
^writing$
^writing/
^CLAUDE\.md$
^bin$
^data$
^data/

# Jupyter notebooks and tutorials (not part of R package build)
^\.ipynb_checkpoints$
^notebooks$
^notebooks/

# OS files
^\.DS_Store$

# Documentation site
^docs$
^_pkgdown\.yml$
^pkgdown$

# CI/CD
^\.travis\.yml$
^codecov\.yml$
^appveyor\.yml$

# Testing artifacts
^covr-report$

# Dependency management
^packrat$
^renv$
^renv\.lock$
