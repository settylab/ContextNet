#!/usr/bin/env python3
"""
save2word - Convert Markdown to Word document with Arial font and 0.5" margins

Usage:
    save2word <input.md> [output.docx]

If output is not specified, it will use the input filename with .docx extension.
"""

import sys
import os
import re
from docx import Document
from docx.shared import Pt, Inches

# LaTeX symbol to Unicode mapping
LATEX_SYMBOLS = {
    r'\times': '×',
    r'\cdot': '·',
    r'\pm': '±',
    r'\leq': '≤',
    r'\geq': '≥',
    r'\neq': '≠',
    r'\approx': '≈',
    r'\infty': '∞',
    r'\sum': 'Σ',
    r'\prod': 'Π',
    r'\int': '∫',
    r'\partial': '∂',
    r'\nabla': '∇',
    r'\alpha': 'α',
    r'\beta': 'β',
    r'\gamma': 'γ',
    r'\delta': 'δ',
    r'\epsilon': 'ε',
    r'\zeta': 'ζ',
    r'\eta': 'η',
    r'\theta': 'θ',
    r'\iota': 'ι',
    r'\kappa': 'κ',
    r'\lambda': 'λ',
    r'\mu': 'μ',
    r'\nu': 'ν',
    r'\xi': 'ξ',
    r'\pi': 'π',
    r'\rho': 'ρ',
    r'\sigma': 'σ',
    r'\tau': 'τ',
    r'\upsilon': 'υ',
    r'\phi': 'φ',
    r'\chi': 'χ',
    r'\psi': 'ψ',
    r'\omega': 'ω',
    r'\Gamma': 'Γ',
    r'\Delta': 'Δ',
    r'\Theta': 'Θ',
    r'\Lambda': 'Λ',
    r'\Xi': 'Ξ',
    r'\Pi': 'Π',
    r'\Sigma': 'Σ',
    r'\Phi': 'Φ',
    r'\Psi': 'Ψ',
    r'\Omega': 'Ω',
    r'\in': '∈',
    r'\notin': '∉',
    r'\subset': '⊂',
    r'\supset': '⊃',
    r'\cup': '∪',
    r'\cap': '∩',
    r'\emptyset': '∅',
    r'\forall': '∀',
    r'\exists': '∃',
    r'\neg': '¬',
    r'\land': '∧',
    r'\lor': '∨',
    r'\rightarrow': '→',
    r'\leftarrow': '←',
    r'\Rightarrow': '⇒',
    r'\Leftarrow': '⇐',
    r'\leftrightarrow': '↔',
    r'\log': 'log',
    r'\ln': 'ln',
    r'\exp': 'exp',
    r'\sin': 'sin',
    r'\cos': 'cos',
    r'\tan': 'tan',
    r'\max': 'max',
    r'\min': 'min',
    r'\text': '',  # Will be handled specially
}


def parse_latex_math(paragraph, math_text, font_name='Arial', is_italic=True):
    """Parse LaTeX math and add formatted runs to paragraph."""
    # Replace LaTeX symbols with Unicode
    text = math_text
    for latex, unicode_char in LATEX_SYMBOLS.items():
        text = text.replace(latex, unicode_char)

    # Handle \text{...} - render as non-italic
    text = re.sub(r'\\text\{([^}]+)\}', r'\1', text)

    # Remove remaining backslashes from unknown commands
    text = re.sub(r'\\([a-zA-Z]+)', r'\1', text)

    # Remove braces that are just grouping (but keep content)
    # Process character by character with subscript/superscript handling
    i = 0
    while i < len(text):
        # Check for subscript
        if text[i] == '_':
            i += 1
            if i < len(text):
                if text[i] == '{':
                    # Find matching brace
                    end = text.find('}', i)
                    if end != -1:
                        sub_text = text[i+1:end]
                        # Recursively handle nested sub/superscripts
                        add_sub_super_text(paragraph, sub_text, is_subscript=True, font_name=font_name, is_italic=is_italic)
                        i = end + 1
                        continue
                else:
                    # Single character subscript
                    run = paragraph.add_run(text[i])
                    run.font.subscript = True
                    run.font.name = font_name
                    if is_italic:
                        run.italic = True
                    i += 1
                    continue

        # Check for superscript
        if text[i] == '^':
            i += 1
            if i < len(text):
                if text[i] == '{':
                    # Find matching brace
                    end = text.find('}', i)
                    if end != -1:
                        sup_text = text[i+1:end]
                        add_sub_super_text(paragraph, sup_text, is_subscript=False, font_name=font_name, is_italic=is_italic)
                        i = end + 1
                        continue
                else:
                    # Single character superscript
                    run = paragraph.add_run(text[i])
                    run.font.superscript = True
                    run.font.name = font_name
                    if is_italic:
                        run.italic = True
                    i += 1
                    continue

        # Skip braces used for grouping
        if text[i] in '{}':
            i += 1
            continue

        # Regular character
        end = i + 1
        while end < len(text) and text[end] not in '_^{}':
            end += 1

        run = paragraph.add_run(text[i:end])
        run.font.name = font_name
        if is_italic:
            run.italic = True
        i = end


def add_sub_super_text(paragraph, text, is_subscript=False, font_name='Arial', is_italic=True):
    """Add text as subscript or superscript, handling nested formatting."""
    # Handle simple cases without nested formatting
    i = 0
    while i < len(text):
        # Check for nested superscript in subscript or vice versa
        if text[i] == '^' and not is_subscript:
            # Already in superscript, just continue
            i += 1
            continue
        if text[i] == '_' and is_subscript:
            # Already in subscript, just continue
            i += 1
            continue

        # Skip braces
        if text[i] in '{}':
            i += 1
            continue

        # Collect regular characters
        end = i + 1
        while end < len(text) and text[end] not in '_^{}':
            end += 1

        run = paragraph.add_run(text[i:end])
        run.font.name = font_name
        if is_subscript:
            run.font.subscript = True
        else:
            run.font.superscript = True
        if is_italic:
            run.italic = True
        i = end


def add_formatted_text(paragraph, text):
    """Add text with inline formatting (bold, italic, superscript, subscript, inline math)"""
    # First, handle code blocks with backticks
    text = re.sub(r'`([^`]+)`', r'\1', text)

    i = 0
    while i < len(text):
        # Check for inline LaTeX math $...$
        if text[i] == '$' and (i == 0 or text[i-1] != '$'):
            # Find closing $
            end = text.find('$', i+1)
            if end != -1 and (end+1 >= len(text) or text[end+1] != '$'):
                math_text = text[i+1:end]
                parse_latex_math(paragraph, math_text, font_name='Arial', is_italic=True)
                i = end + 1
                continue

        # Check for superscript with ^
        if text[i:i+1] == '^' and not text[i:i+2] == '^[':
            end = text.find('^', i+1)
            if end != -1:
                sup_text = text[i+1:end]
                run = paragraph.add_run(sup_text)
                run.font.superscript = True
                run.font.name = 'Arial'
                i = end + 1
                continue

        # Check for HTML superscript
        sup_match = re.match(r'<sup>([^<]+)</sup>', text[i:])
        if sup_match:
            run = paragraph.add_run(sup_match.group(1))
            run.font.superscript = True
            run.font.name = 'Arial'
            i += len(sup_match.group(0))
            continue

        # Check for HTML subscript
        sub_match = re.match(r'<sub>([^<]+)</sub>', text[i:])
        if sub_match:
            run = paragraph.add_run(sub_match.group(1))
            run.font.subscript = True
            run.font.name = 'Arial'
            i += len(sub_match.group(0))
            continue

        # Check for bold **text**
        bold_match = re.match(r'\*\*([^*]+)\*\*', text[i:])
        if bold_match:
            run = paragraph.add_run(bold_match.group(1))
            run.bold = True
            run.font.name = 'Arial'
            i += len(bold_match.group(0))
            continue

        # Check for italic *text*
        italic_match = re.match(r'\*([^*]+)\*', text[i:])
        if italic_match:
            run = paragraph.add_run(italic_match.group(1))
            run.italic = True
            run.font.name = 'Arial'
            i += len(italic_match.group(0))
            continue

        # Check for citation ^number^
        cite_match = re.match(r'\^(\d+(?:,\d+)*)\^', text[i:])
        if cite_match:
            run = paragraph.add_run(cite_match.group(1))
            run.font.superscript = True
            run.font.name = 'Arial'
            i += len(cite_match.group(0))
            continue

        # Check for citation ^[text]^
        cite_match2 = re.match(r'\^\[([^\]]+)\]\^', text[i:])
        if cite_match2:
            run = paragraph.add_run('[' + cite_match2.group(1) + ']')
            run.font.superscript = True
            run.font.name = 'Arial'
            i += len(cite_match2.group(0))
            continue

        # Regular character - collect until next special character
        end = i + 1
        while end < len(text):
            if text[end] in '*^<$':
                break
            end += 1

        run = paragraph.add_run(text[i:end])
        run.font.name = 'Arial'
        i = end


def convert_markdown_to_word(input_path, output_path):
    """Convert a markdown file to a Word document."""

    # Read the markdown file
    with open(input_path, 'r') as f:
        content = f.read()

    # Create a new Word document
    doc = Document()

    # Set margins to 0.5 inches
    for section in doc.sections:
        section.top_margin = Inches(0.5)
        section.bottom_margin = Inches(0.5)
        section.left_margin = Inches(0.5)
        section.right_margin = Inches(0.5)

    # Set default font to Arial
    style = doc.styles['Normal']
    font = style.font
    font.name = 'Arial'
    font.size = Pt(11)

    # Update heading styles to use Arial
    for i in range(1, 4):
        heading_style = doc.styles[f'Heading {i}']
        heading_style.font.name = 'Arial'

    # Process the markdown content
    lines = content.split('\n')
    i = 0

    while i < len(lines):
        line = lines[i].strip()

        # Skip empty lines
        if not line:
            i += 1
            continue

        # Skip horizontal rules
        if line == '---':
            i += 1
            continue

        # Handle display math blocks $$...$$
        if line.startswith('$$'):
            # Check if it's a single-line display math
            if line.endswith('$$') and len(line) > 4:
                math_content = line[2:-2]
                p = doc.add_paragraph()
                p.alignment = 1  # Center alignment
                parse_latex_math(p, math_content, font_name='Arial', is_italic=True)
                i += 1
                continue
            else:
                # Multi-line display math - collect until closing $$
                math_lines = []
                if len(line) > 2:
                    math_lines.append(line[2:])
                i += 1
                while i < len(lines):
                    next_line = lines[i].strip()
                    if next_line.endswith('$$'):
                        if len(next_line) > 2:
                            math_lines.append(next_line[:-2])
                        break
                    math_lines.append(next_line)
                    i += 1
                math_content = ' '.join(math_lines)
                p = doc.add_paragraph()
                p.alignment = 1  # Center alignment
                parse_latex_math(p, math_content, font_name='Arial', is_italic=True)
                i += 1
                continue

        # Handle headers
        if line.startswith('## ') and not line.startswith('### '):
            p = doc.add_heading(line[3:], level=1)
            for run in p.runs:
                run.font.name = 'Arial'
            i += 1
            continue

        if line.startswith('### '):
            p = doc.add_heading(line[4:], level=2)
            for run in p.runs:
                run.font.name = 'Arial'
            i += 1
            continue

        if line.startswith('#### '):
            p = doc.add_heading(line[5:], level=3)
            for run in p.runs:
                run.font.name = 'Arial'
            i += 1
            continue

        # Handle bullet points
        if line.startswith('- **'):
            p = doc.add_paragraph(style='List Bullet')
            match = re.match(r'- \*\*([^*]+)\*\*:?\s*(.*)', line)
            if match:
                run = p.add_run(match.group(1))
                run.bold = True
                run.font.name = 'Arial'
                if match.group(2):
                    p.add_run(': ' if ':' in line else '')
                    add_formatted_text(p, match.group(2))
            i += 1
            continue

        if line.startswith('- '):
            p = doc.add_paragraph(style='List Bullet')
            add_formatted_text(p, line[2:])
            i += 1
            continue

        # Handle numbered references
        ref_match = re.match(r'^(\d+)\.\s+(.+)$', line)
        if ref_match:
            p = doc.add_paragraph()
            run = p.add_run(ref_match.group(1) + '. ')
            run.font.name = 'Arial'
            add_formatted_text(p, ref_match.group(2))
            i += 1
            continue

        # Regular paragraph
        p = doc.add_paragraph()
        add_formatted_text(p, line)
        i += 1

    # Save the document
    doc.save(output_path)
    print(f"Saved: {output_path}")
    print(f"  Font: Arial (11pt)")
    print(f"  Margins: 0.5 inches (all sides)")


def main():
    if len(sys.argv) < 2:
        print(__doc__)
        sys.exit(1)

    input_path = sys.argv[1]

    if not os.path.exists(input_path):
        print(f"Error: File not found: {input_path}")
        sys.exit(1)

    if len(sys.argv) >= 3:
        output_path = sys.argv[2]
    else:
        # Replace .md extension with .docx
        base = os.path.splitext(input_path)[0]
        output_path = base + '.docx'

    convert_markdown_to_word(input_path, output_path)


if __name__ == '__main__':
    main()
